---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { goalLabel, levelLabel, parseLevelId } from '../lib/goals';
import { url } from '../lib/url';

const goals = (await getCollection('goals')).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const levels = (await getCollection('levels')).map((entry) => parseLevelId(entry.id)).sort((a, b) => a.level - b.level);
const levelsOf = (goalSlug: string) => levels.filter((level) => level.goalSlug === goalSlug);
---

<Base title="AI engineering journal">
	<h1>Road to AI / ML Engineer</h1>
	<p class="muted">Each goal is studied in three levels: surface, practical, and expertise.</p>

	<section class="panel how-to-study">
		<h2>How to study</h2>
		<ol>
			<li><b>Breadth</b> — read every L1, G1 to G8, so any interview question gets a correct short answer.</li>
			<li><b>Practice</b> — work through L2 in priority order: G1, G6, G5, G3, G4, G2, building the capstone as you go; practice G8 in the agent that builds it.</li>
			<li><b>Depth</b> — L3 for G1 and everything the capstone uses; rehearse the G7 stories.</li>
			<li><b>Rehearsal</b> — the readiness checklist in goal.md, then mock interviews.</li>
		</ol>
	</section>

	<ul class="panel goals">
		{
			goals.map(({ id, data }) => (
				<li>
					<a class="goal-title" href={url(`/${id}/`)}>
						<span class="goal-label">{goalLabel(id)}</span> {data.title}
					</a>
					{data.description && <p class="muted">{data.description}</p>}
					<p class="goal-levels">
						{levelsOf(id).map((level) => (
							<a class="tag" href={url(`/${id}/${level.levelSlug}/`)}>
								{levelLabel(level.level)}
							</a>
						))}
					</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.how-to-study {
		padding: 4px 18px 8px;
		margin-top: 18px;
	}
	.how-to-study h2 {
		margin-top: 12px;
	}
	.how-to-study li + li {
		margin-top: 4px;
	}
	.goals {
		list-style: none;
		margin: 20px 0 0;
		padding: 0;
	}
	.goals li {
		padding: 14px 16px;
		border-bottom: 1.5px solid var(--rule);
	}
	.goals li:last-child {
		border-bottom: none;
	}
	.goal-title {
		font-weight: 700;
		text-decoration: none;
	}
	.goal-label {
		color: var(--muted);
	}
	.goals p {
		margin: 4px 0 0;
		font-size: 0.92rem;
	}
	.goal-levels .tag {
		color: var(--ink);
		text-decoration: none;
	}
</style>
